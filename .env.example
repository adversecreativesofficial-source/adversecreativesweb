# Firebase web config (client-side, safe to expose — security is enforced by
# Firestore/Storage rules). Copy this file to `.env` and fill in real values
# from Firebase Console → Project settings → General → "Your apps" → SDK setup
# and configuration → Config.
#
# In production (Netlify), set these same keys in
# Site settings → Environment variables.

PUBLIC_FIREBASE_API_KEY=REPLACE_ME
PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_ME.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=REPLACE_ME
PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_ME.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
PUBLIC_FIREBASE_APP_ID=REPLACE_ME
