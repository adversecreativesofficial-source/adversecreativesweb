---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import LocationsSection from "../components/LocationsSection.astro";
import contactBg from "../assets/contact_bg.svg";
import { getEntry } from "astro:content";

const indexEntry = await getEntry("pages", "index");
const contactEntry = await getEntry("pages", "contact");

if (!indexEntry || !contactEntry) {
  return Astro.redirect("/404");
}

const { navbar, footer } = indexEntry.data;
const { hero, contactSection, mapSection } = contactEntry.data;
---

<Layout>
  {
    navbar && (
      <Navbar {...navbar} contactButton={{ text: "Back to Home", link: "/" }} />
    )
  }

  <main class="min-h-screen bg-[#080b14]">
    <!-- Hero Section -->
    {hero && <Hero {...hero} backgroundImage={contactBg} compact={true} />}

    <!-- Content Section -->
    {
      contactSection && (
        <section class="max-w-7xl mx-auto px-4 md:px-12 py-20">
          <div class="grid lg:grid-cols-2 gap-8 lg:gap-24 items-start">
            {/* Left Column: Title & Description */}
            <div>
              <h2 class="font-['Poppins'] font-black text-[36px] leading-[46px] text-white mb-2 leading-tight">
                {contactSection.title}
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#4068FC] to-[#00229D]">
                  {contactSection.highlight}
                </span>
              </h2>
              <p class="font-['Poppins'] font-normal text-[20px] leading-[30px] text-[#9aa6c6] mb-8 max-w-[611px]">
                {contactSection.description}
              </p>
            </div>

            {/* Right Column: Contact Cards */}
            <div class="space-y-4">
              {/* Phone Cards */}
              {contactSection.phones?.map((phone: any) => (
                <div class="bg-white/[0.04] rounded-[12px] flex flex-row items-center p-[18px] gap-[24px] w-full md:w-[420px] h-auto md:h-[102px] border border-white/10 box-border">
                  <div class="w-[51px] h-[51px] bg-[#4264DF]/10 rounded-[12px] flex flex-none items-center justify-center order-0 flex-grow-0 p-[12px] gap-[10px]">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-[27px] h-[27px] text-[#3253CC]"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.11-.14 11.23 11.23 0 003.5.56 1 1 0 011 1v3.5a1 1 0 01-1 1A16 16 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.23 11.23 0 00.56 3.5 1 1 0 01-.14 1.11l-2.2 2.18z" />
                    </svg>
                  </div>
                  <div class="flex flex-col items-start p-0 gap-[6px] min-w-[151px] h-[66px]">
                    <p class="font-['Poppins'] font-medium text-[20px] leading-[30px] tracking-[-0.02em] text-[#B4B4B4] flex items-center h-[30px]">
                      {phone.label}
                    </p>
                    <a
                      href={`tel:${phone.number.replace(/\s+/g, "")}`}
                      class="font-['Poppins'] font-medium text-[20px] leading-[30px] tracking-[-0.02em] text-white flex items-center h-[30px] hover:text-[#4068FC] transition-colors"
                    >
                      {phone.number}
                    </a>
                  </div>
                </div>
              ))}

              {/* Email Cards */}
              {contactSection.emails?.map((email: any) => (
                <div class="bg-white/[0.04] rounded-[12px] flex flex-row items-center p-[18px] gap-[24px] w-full md:w-[420px] h-auto md:h-[102px] border border-white/10 box-border">
                  <div class="w-[51px] h-[51px] bg-[#4264DF]/10 rounded-[12px] flex flex-none items-center justify-center order-0 flex-grow-0 p-[12px] gap-[10px]">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-[27px] h-[27px] text-[#3253CC]"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z" />
                      <path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z" />
                    </svg>
                  </div>
                  <div class="flex flex-col items-start p-0 gap-[6px] min-w-[151px] h-[66px]">
                    <p class="font-['Poppins'] font-medium text-[20px] leading-[30px] tracking-[-0.02em] text-[#B4B4B4] flex items-center h-[30px]">
                      {email.label}
                    </p>
                    <a
                      href={`mailto:${email.address}`}
                      class="font-['Poppins'] font-medium text-[20px] leading-[30px] tracking-[-0.02em] text-white flex items-center h-[30px] break-all hover:text-[#4068FC] transition-colors"
                    >
                      {email.address}
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Map Section -->
    {mapSection && <LocationsSection mapSection={mapSection} />}
  </main>
  {footer && <Footer {...footer} />}
</Layout>
