---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import adverseLogo from "../../assets/adverse-logo.svg";
import { getEntry } from "astro:content";

// One shareable catalog per franchise. Clients tap the screens they want and
// enquire on WhatsApp in one step — the message is pre-filled with the names.
export function getStaticPaths() {
  return [
    {
      params: { franchise: "bangalore" },
      props: {
        name: "Bangalore",
        whatsapp: "919110870573",
        blurb:
          "Premium digital screens across Bengaluru's busiest cafés, restaurants and hangouts.",
      },
    },
    {
      params: { franchise: "kerala" },
      props: {
        name: "Kerala",
        whatsapp: "918289854185",
        blurb:
          "Now live in Kochi — premium screens where Kerala actually looks.",
      },
    },
  ];
}

const { franchise } = Astro.params;
const { name, whatsapp, blurb } = Astro.props as {
  name: string;
  whatsapp: string;
  blurb: string;
};

// Static fallback (names only — images live in Firestore) for no-JS / SEO.
const contactEntry = await getEntry("pages", "contact");
const fallback = (contactEntry?.data.mapSection?.locations ?? [])
  .filter((l: any) => (l.franchise ?? "bangalore") === franchise)
  .map((l: any) => ({
    area: l.area,
    venue: l.venue,
    footfall: l.footfall,
    mapLink: l.link,
  }));
---

<Layout>
  <main
    class="catalog"
    data-catalog
    data-franchise={franchise}
    data-region={name}
    data-whatsapp={whatsapp}
  >
    <!-- Top bar -->
    <header class="topbar">
      <a href="/" class="brand" aria-label="AdVerse Creatives home">
        <Image src={adverseLogo} alt="AdVerse Creatives" class="brand-logo" />
      </a>
      <button type="button" class="share-btn" data-share>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        <span data-share-label>Share</span>
      </button>
    </header>

    <!-- Cover -->
    <section class="cover" data-cover>
      <div class="cover-media" data-cover-media></div>
      <div class="cover-shade"></div>
      <div class="cover-inner">
        <span class="eyebrow">
          <span class="live-dot"></span> Live network · {name}
        </span>
        <h1 class="cover-title">
          Your ad, on our <span class="hl">{name}</span> screens.
        </h1>
        <p class="cover-blurb">{blurb}</p>
        <div class="cover-meta">
          <span class="count-pill"><b data-count-num>—</b> screens</span>
          <span class="hint">Tap the ones you want ↓</span>
        </div>
      </div>
    </section>

    <!-- Gallery -->
    <section class="gallery">
      <div class="gallery-head">
        <h2 class="gallery-title">Pick your screens</h2>
        <button type="button" class="ghost-btn" data-selectall>Select all</button>
      </div>

      <div class="grid" data-grid>
        <!-- Skeleton while Firestore loads -->
        <div class="skeleton"></div>
        <div class="skeleton"></div>
        <div class="skeleton"></div>
      </div>

      <p class="empty" data-empty hidden>No screens live here yet — check back soon.</p>

      <noscript>
        <ul class="noscript-list">
          {fallback.map((s: any) => (
            <li><b>{s.area}</b> — {s.venue} · {s.footfall}</li>
          ))}
        </ul>
        <p class="noscript-note">Enable JavaScript to select screens and enquire.</p>
      </noscript>
    </section>

    <!-- Floating enquire bar -->
    <div class="enquire" data-enquire hidden>
      <div class="enquire-inner">
        <div class="enquire-count">
          <b data-sel-num>0</b> selected
          <button type="button" class="clear-btn" data-clear>Clear</button>
        </div>
        <a class="wa-btn" data-enquire-btn href="#" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="wa-icon">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.485 3.488"></path>
          </svg>
          <span data-enquire-label>Enquire on WhatsApp</span>
        </a>
      </div>
    </div>

    <div class="toast" data-toast hidden></div>
  </main>
</Layout>

<script>
  import "../../scripts/screen-catalog";
</script>

<style is:global>
  .catalog {
    /* ---- tokens (AdVerse identity) ---- */
    --ink: #080b14;
    --ink-2: #0c111f;
    --elev: #121a2e;
    --line: rgba(255, 255, 255, 0.09);
    --brand: #3253cc;
    --glow: #859ef8;
    --paper: #eef1fb;
    --muted: #9aa6c6;
    --radius: 18px;
    --bar-h: 84px;

    background: var(--ink);
    color: var(--paper);
    min-height: 100vh;
    padding-bottom: calc(var(--bar-h) + env(safe-area-inset-bottom, 0px) + 24px);
    overflow-x: clip;
    font-family: "Poppins", "Inter", sans-serif;
  }

  /* ---- top bar ---- */
  .catalog .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--ink) 78%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .catalog .brand-logo {
    width: clamp(120px, 22vw, 150px);
    height: auto;
  }
  .catalog .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    color: var(--paper);
    font: 600 13px "Poppins", sans-serif;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .catalog .share-btn:hover {
    border-color: color-mix(in srgb, var(--brand) 60%, transparent);
    background: rgba(255, 255, 255, 0.07);
  }
  .catalog .share-btn svg { width: 16px; height: 16px; }

  /* ---- cover ---- */
  .catalog .cover {
    position: relative;
    min-height: clamp(360px, 56vh, 620px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
  }
  .catalog .cover-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(80% 60% at 70% 10%, color-mix(in srgb, var(--brand) 55%, transparent), transparent 70%),
      linear-gradient(135deg, #16205a, var(--ink) 70%);
    background-size: cover;
    background-position: center;
    transform: scale(1.04);
    transition: opacity 0.6s ease;
  }
  .catalog .cover-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--ink) 30%, transparent) 0%,
      color-mix(in srgb, var(--ink) 55%, transparent) 45%,
      var(--ink) 100%
    );
  }
  .catalog .cover-inner {
    padding: clamp(24px, 5vw, 56px);
    max-width: 900px;
  }
  .catalog .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 700 12px "Poppins", sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--glow);
    margin-bottom: 16px;
  }
  .catalog .live-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #12b76a;
    box-shadow: 0 0 0 0 rgba(18, 183, 106, 0.6);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(18,183,106,.5); }
    70% { box-shadow: 0 0 0 8px rgba(18,183,106,0); }
    100% { box-shadow: 0 0 0 0 rgba(18,183,106,0); }
  }
  .catalog .cover-title {
    font: 800 clamp(34px, 6vw, 60px)/1.03 "Outfit", sans-serif;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
  }
  .catalog .cover-title .hl {
    background: linear-gradient(90deg, var(--glow), var(--brand));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .catalog .cover-blurb {
    font: 400 clamp(15px, 2.2vw, 19px)/1.5 "Poppins", sans-serif;
    color: var(--muted);
    max-width: 640px;
    margin: 0 0 22px;
  }
  .catalog .cover-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .catalog .count-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--line);
    font: 500 14px "Poppins", sans-serif;
    color: var(--muted);
  }
  .catalog .count-pill b {
    font: 800 18px "Outfit", sans-serif;
    color: var(--paper);
    font-variant-numeric: tabular-nums;
  }
  .catalog .hint { font: 500 13px "Poppins", sans-serif; color: var(--glow); }

  /* ---- gallery ---- */
  .catalog .gallery {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 52px) clamp(16px, 4vw, 40px) 0;
  }
  .catalog .gallery-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
  }
  .catalog .gallery-title {
    font: 700 clamp(20px, 3vw, 28px) "Outfit", sans-serif;
    margin: 0;
  }
  .catalog .ghost-btn {
    background: none;
    border: 1px solid var(--line);
    color: var(--glow);
    border-radius: 999px;
    min-height: 40px;
    padding: 0 18px;
    font: 600 13px "Poppins", sans-serif;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .catalog .ghost-btn:hover { border-color: color-mix(in srgb, var(--brand) 55%, transparent); background: rgba(255,255,255,.04); }

  .catalog .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: clamp(14px, 2vw, 22px);
  }

  /* ---- screen card (the "display") ---- */
  .catalog .scr-card {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--elev);
    cursor: pointer;
    text-align: left;
    padding: 0;
    color: inherit;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    will-change: transform;
  }
  .catalog .scr-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,0,0,0.4); }
  .catalog .scr-card:focus-visible { outline: none; box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 70%, transparent); }

  .catalog .scr-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .catalog .scr-media img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, filter 0.3s ease;
  }
  .catalog .scr-card:hover .scr-media img { transform: scale(1.06); }
  .catalog .scr-ph {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font: 800 40px "Outfit", sans-serif; color: rgba(255,255,255,.9);
  }
  .catalog .scr-grad {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(6,9,20,.92) 100%);
  }
  .catalog .scr-body {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 14px 16px;
  }
  .catalog .scr-area {
    font: 700 17px "Poppins", sans-serif;
    margin: 0 0 2px;
    color: #fff;
  }
  .catalog .scr-venue {
    font: 500 13px "Poppins", sans-serif;
    color: rgba(255,255,255,.72);
    margin: 0 0 8px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .catalog .scr-foot {
    display: inline-block;
    font: 700 10px "Poppins", sans-serif;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--glow);
    background: color-mix(in srgb, var(--brand) 22%, transparent);
    border-radius: 6px;
    padding: 4px 8px;
    font-variant-numeric: tabular-nums;
  }

  /* select check badge */
  .catalog .scr-check {
    position: absolute;
    top: 12px; right: 12px;
    width: 30px; height: 30px;
    border-radius: 50%;
    display: grid; place-items: center;
    background: rgba(8,11,20,.55);
    border: 1.5px solid rgba(255,255,255,.55);
    backdrop-filter: blur(4px);
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .catalog .scr-check svg { width: 16px; height: 16px; color: #fff; opacity: 0; transition: opacity .18s; }

  /* selected = the screen "powers on" */
  .catalog .scr-card.sel {
    border-color: var(--brand);
    box-shadow: 0 0 0 2px var(--brand), 0 14px 44px color-mix(in srgb, var(--brand) 35%, transparent);
  }
  .catalog .scr-card.sel .scr-media img { filter: brightness(1.06) saturate(1.05); }
  .catalog .scr-card.sel .scr-check {
    background: var(--brand);
    border-color: var(--brand);
    transform: scale(1.08);
  }
  .catalog .scr-card.sel .scr-check svg { opacity: 1; }

  /* map link chip (doesn't toggle selection) */
  .catalog .scr-map {
    position: absolute;
    top: 12px; left: 12px;
    width: 30px; height: 30px;
    border-radius: 50%;
    display: grid; place-items: center;
    background: rgba(8,11,20,.55);
    border: 1px solid var(--line);
    color: #fff;
    backdrop-filter: blur(4px);
    opacity: 0; transition: opacity .2s;
  }
  .catalog .scr-card:hover .scr-map, .catalog .scr-map:focus-visible { opacity: 1; }
  .catalog .scr-map svg { width: 15px; height: 15px; }

  /* skeleton + empty */
  .catalog .skeleton {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: linear-gradient(100deg, var(--elev) 30%, #1a2440 50%, var(--elev) 70%);
    background-size: 200% 100%;
    animation: shimmer 1.3s infinite linear;
  }
  @keyframes shimmer { to { background-position: -200% 0; } }
  .catalog .empty { text-align: center; color: var(--muted); padding: 48px 0; font: 500 15px "Poppins"; }
  .catalog .noscript-list { list-style: none; padding: 0; color: var(--muted); line-height: 1.9; }
  .catalog .noscript-note { color: var(--glow); }

  /* ---- floating enquire bar ---- */
  .catalog .enquire {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 50;
    padding: 12px clamp(12px, 4vw, 24px) calc(12px + env(safe-area-inset-bottom, 0px));
    background: color-mix(in srgb, var(--ink) 82%, transparent);
    backdrop-filter: blur(16px);
    border-top: 1px solid var(--line);
    transform: translateY(120%);
    transition: transform 0.3s cubic-bezier(.2,.8,.2,1);
  }
  .catalog .enquire.show { transform: translateY(0); }
  .catalog .enquire-inner {
    max-width: 1000px; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
  }
  .catalog .enquire-count { font: 500 15px "Poppins"; color: var(--muted); }
  .catalog .enquire-count b { color: var(--paper); font: 800 18px "Outfit"; font-variant-numeric: tabular-nums; }
  .catalog .clear-btn {
    background: none; border: none; color: var(--glow);
    font: 600 13px "Poppins"; cursor: pointer; margin-left: 12px; text-decoration: underline;
  }
  .catalog .wa-btn {
    display: inline-flex; align-items: center; gap: 10px;
    min-height: 48px; padding: 0 24px;
    border-radius: 999px;
    background: #25d366;
    color: #06210f;
    font: 700 15px "Poppins", sans-serif;
    text-decoration: none;
    box-shadow: 0 8px 26px rgba(37, 211, 102, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    white-space: nowrap;
  }
  .catalog .wa-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(37,211,102,.45); }
  .catalog .wa-icon { width: 20px; height: 20px; }

  /* toast */
  .catalog .toast {
    position: fixed;
    left: 50%; bottom: calc(var(--bar-h) + 20px);
    transform: translateX(-50%) translateY(10px);
    z-index: 60;
    background: var(--elev);
    border: 1px solid var(--line);
    color: var(--paper);
    padding: 10px 18px;
    border-radius: 999px;
    font: 600 13px "Poppins";
    opacity: 0;
    transition: opacity .25s, transform .25s;
    pointer-events: none;
  }
  .catalog .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

  @media (max-width: 520px) {
    .catalog .enquire-inner { flex-direction: column; gap: 10px; align-items: stretch; }
    .catalog .wa-btn { justify-content: center; }
    .catalog .enquire-count { text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .catalog * { animation: none !important; transition: none !important; }
  }
</style>
