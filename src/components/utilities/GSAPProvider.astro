---
// Global scroll-reveal engine.
// Any element marked with `data-reveal` (fade/slide up) or `data-reveal-card`
// (staggered grid entrance) animates in on scroll. Honors reduced-motion, and
// never leaves content hidden: the initial hidden state is CSS-only (no lingering
// inline styles), and a readiness-gated failsafe reveals everything if the engine
// fails to run. The failsafe is only triggered on real failure (the engine never
// marked itself ready), so normal below-the-fold scroll reveals are preserved.
---

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const root = document.documentElement;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function reveal(
    selector: string,
    opts: { y: number; duration: number; stagger: number }
  ) {
    const els = gsap.utils.toArray<HTMLElement>(selector);
    if (!els.length) return;
    ScrollTrigger.batch(els, {
      start: "top 90%",
      once: true,
      onEnter: (batch) =>
        gsap.fromTo(
          batch,
          { opacity: 0, y: opts.y },
          {
            opacity: 1,
            y: 0,
            duration: opts.duration,
            stagger: opts.stagger,
            ease: "power2.out",
            overwrite: true,
          }
        ),
    });
  }

  if (reduce) {
    // Reveal everything immediately; CSS media query covers this too.
    root.classList.add("gsap-failsafe");
  } else {
    reveal("[data-reveal]", { y: 24, duration: 0.7, stagger: 0.08 });
    reveal("[data-reveal-card]", { y: 32, duration: 0.6, stagger: 0.07 });
    requestAnimationFrame(() => ScrollTrigger.refresh());
  }

  // Tell the Layout failsafe the engine is up, so it won't force-reveal.
  (window as any).__gsapRevealReady = true;
</script>

<style is:global>
  /* Initial hidden state (CSS-only) while the engine is active and healthy. */
  html.gsap-reveal:not(.gsap-failsafe) [data-reveal],
  html.gsap-reveal:not(.gsap-failsafe) [data-reveal-card] {
    opacity: 0;
  }
  /* Failsafe / reduced-motion: force everything visible, overriding any inline
     opacity GSAP may have set mid-animation before failing. */
  html.gsap-failsafe [data-reveal],
  html.gsap-failsafe [data-reveal-card] {
    opacity: 1 !important;
    transform: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    html.gsap-reveal [data-reveal],
    html.gsap-reveal [data-reveal-card] {
      opacity: 1 !important;
    }
  }
</style>
