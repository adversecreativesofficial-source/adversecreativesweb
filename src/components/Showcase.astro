---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import showcaseLogo from "../assets/showcase/showcase-logo.svg";

type Props = NonNullable<CollectionEntry<"pages">["data"]["showcase"]>;

const {
  label,
  title,
  highlight,
  description,
  mainImage,
  videoUrl,
  videos,
  rightImage,
  features,
} = Astro.props as Props;

// Build the auto-rotating slide list: prefer `videos`, fall back to the single
// `videoUrl`. Empty → still image with a play affordance.
const slides = (videos && videos.length
  ? videos
  : videoUrl
    ? [videoUrl]
    : []
).filter(Boolean);
---

<section
  id="showcase-section"
  data-section-theme="dark"
  class="py-24 px-6 md:px-12 max-w-7xl mx-auto"
>
  <div class="text-center mb-16 flex flex-col items-center gap-2">
    <span
      class="font-poppins font-medium text-[20px] leading-[30px] text-[#859EF8]"
      data-reveal
      >{label}</span
    >
    <h2
      class="font-poppins font-semibold text-[36px] leading-[54px] text-white"
      data-reveal
    >
      {title}
      <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-[#7E9BFF] to-[#4068FC]"
        >{highlight}</span
      >
    </h2>
    <p
      class="font-poppins font-normal text-[20px] leading-[30px] text-[#9aa6c6] max-w-2xl mx-auto"
      data-reveal
    >
      {description}
    </p>
  </div>

  <div class="flex flex-col lg:grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Large Video Carousel (auto-slides between videos) -->
    <div
      data-reveal-img
      class="lg:col-span-2 relative rounded-3xl overflow-hidden group h-[500px]"
    >
      {
        slides.length ? (
          <div class="showcase-carousel absolute inset-0 bg-[#0e1424]">
            {slides.map((src, i) => (
              <video
                data-slide={i}
                src={src}
                poster={mainImage}
                autoplay
                loop
                muted
                playsinline
                preload={i === 0 ? "auto" : "metadata"}
                class:list={[
                  "showcase-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-in-out",
                  i === 0 ? "opacity-100" : "opacity-0",
                ]}
              />
            ))}

            {slides.length > 1 && (
              <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex items-center gap-2 z-10">
                {slides.map((_, i) => (
                  <button
                    type="button"
                    data-dot={i}
                    aria-label={`Show video ${i + 1}`}
                    class:list={[
                      "showcase-dot h-2.5 rounded-full transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70",
                      i === 0 ? "w-6 bg-white" : "w-2.5 bg-white/40 hover:bg-white/70",
                    ]}
                  />
                ))}
              </div>
            )}
          </div>
        ) : (
          <div class="absolute inset-0 bg-[#0e1424] flex items-center justify-center">
            <img
              src={mainImage}
              alt="City Street Screen"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="w-16 h-16 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center border border-white/30 cursor-pointer hover:bg-white/30 transition-all">
                <svg class="w-6 h-6 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>
          </div>
        )
      }
    </div>

    <!-- Right Side Info Card -->
    <div
      data-reveal
      class="flex flex-col justify-end relative overflow-visible"
    >
      <!-- Background Image if present -->
      {
        rightImage && (
          <div class="absolute inset-0 rounded-[12px] border border-blue-500/20 overflow-hidden bg-gradient-to-b from-[#3253CC] to-[#011661]">
            <Image
              src={showcaseLogo}
              alt="Showcase Logo"
              class="absolute top-0 left-0 w-auto h-auto"
            />
          </div>
        )
      }

      <!-- Content Wrapper with Padding -->
      <div
        class="relative lg:absolute lg:inset-0 p-8 flex flex-col justify-end pointer-events-none"
      >
        <h3 class="text-2xl font-bold mb-6 font-outfit text-white">
          You can't skip the screen while waiting for coffee.
        </h3>

        <ul class="space-y-4">
          {
            features.map((feature) => (
              <li class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-blue-400 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d={
                      feature.icon ||
                      "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                    }
                  />
                </svg>
                <span class="text-white/90">{feature.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  // Auto-rotating video carousel for "Our Screens. Your Visibility."
  function setupShowcaseCarousel() {
    document
      .querySelectorAll<HTMLElement>(".showcase-carousel")
      .forEach((car) => {
        const slides = Array.from(
          car.querySelectorAll<HTMLVideoElement>(".showcase-slide")
        );
        const dots = Array.from(
          car.querySelectorAll<HTMLButtonElement>(".showcase-dot")
        );
        if (slides.length < 2) return;

        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        let idx = 0;
        let timer: number | undefined;
        const INTERVAL = 5000;

        const show = (n: number) => {
          idx = (n + slides.length) % slides.length;
          slides.forEach((v, i) => {
            const active = i === idx;
            v.style.opacity = active ? "1" : "0";
            if (active) {
              try {
                v.currentTime = 0;
                v.play?.().catch(() => {});
              } catch {}
            }
          });
          dots.forEach((d, i) => {
            const active = i === idx;
            d.classList.toggle("w-6", active);
            d.classList.toggle("bg-white", active);
            d.classList.toggle("w-2.5", !active);
            d.classList.toggle("bg-white/40", !active);
          });
        };

        const stop = () => {
          if (timer) window.clearInterval(timer);
          timer = undefined;
        };
        const start = () => {
          if (reduce) return;
          stop();
          timer = window.setInterval(() => show(idx + 1), INTERVAL);
        };

        dots.forEach((d, i) =>
          d.addEventListener("click", () => {
            show(i);
            start();
          })
        );
        car.addEventListener("mouseenter", stop);
        car.addEventListener("mouseleave", start);

        show(0);
        start();
      });
  }

  document.addEventListener("DOMContentLoaded", setupShowcaseCarousel);
  document.addEventListener("astro:page-load", setupShowcaseCarousel);
</script>
