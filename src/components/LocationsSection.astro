---
import { Image } from "astro:assets";

type Location = {
  area: string;
  city: string;
  venue: string;
  footfall: string;
  link: string;
  franchise?: "bangalore" | "kerala";
  image?: string;
};

type Franchise = {
  id: string;
  name: string;
  status: "active" | "coming_soon";
  order?: number;
  tagline?: string;
};

type MapSection = {
  label?: string;
  title: string;
  highlight: string;
  description: string;
  stats?: { value: string; label: string; subLabel?: string }[];
  franchises?: Franchise[];
  locations: Location[];
};

const { mapSection } = Astro.props as { mapSection: MapSection };

// Real screen photos (optional) — drop files into src/assets/screens/.
// Falls back to a generated gradient placeholder when missing.
const screenImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/screens/*.{jpeg,jpg,png,webp,avif}",
  { eager: true }
);

function resolveImage(image?: string): ImageMetadata | null {
  if (!image) return null;
  const match = screenImages[`../assets/screens/${image}`];
  return match ? match.default : null;
}

// Deterministic brand-blue gradient + initials for placeholder cards.
const GRADIENTS = [
  ["#3253CC", "#1B2C7A"],
  ["#4068FC", "#00229D"],
  ["#5A7BFF", "#2438B5"],
  ["#2E45B8", "#0A1A66"],
  ["#3A5BD9", "#13218C"],
];
function placeholderFor(venue: string) {
  let hash = 0;
  for (let i = 0; i < venue.length; i++) hash = (hash * 31 + venue.charCodeAt(i)) >>> 0;
  const [from, to] = GRADIENTS[hash % GRADIENTS.length];
  const initials = venue
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase() ?? "")
    .join("");
  return { from, to, initials };
}

// Build franchise groups in display order (active first by `order`).
const fallbackFranchises: Franchise[] = [
  { id: "bangalore", name: "Bangalore", status: "active", order: 1 },
];
const franchises = (mapSection.franchises ?? fallbackFranchises)
  .slice()
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));

const groups = franchises.map((f) => ({
  franchise: f,
  locations: mapSection.locations.filter(
    (l) => (l.franchise ?? "bangalore") === f.id
  ),
}));
---

<section class="py-20 bg-[#F6F7FF]" data-reveal-section>
  <div class="max-w-7xl mx-auto px-4 md:px-12 text-center md:text-left">
    {mapSection.label && (
      <span
        class="font-['Poppins'] font-bold text-[12px] leading-[18px] tracking-[0.08em] uppercase text-[#737373] mb-4 block"
        data-reveal
      >
        {mapSection.label}
      </span>
    )}
    <h2
      class="font-['Poppins'] font-bold text-[40px] md:text-[52px] leading-[1.1] text-[#0A0A0A] mb-4 tracking-[-0.02em]"
      data-reveal
    >
      {mapSection.title}
      <br class="hidden md:block" />
      <span class="text-[#3253CC]">{mapSection.highlight}</span>
    </h2>
    <p
      class="font-['Poppins'] font-normal text-[18px] leading-[28px] text-[#525252] max-w-2xl mb-12"
      data-reveal
    >
      {mapSection.description}
    </p>

    {mapSection.stats && (
      <div
        class="bg-white rounded-[16px] p-8 shadow-[0px_4px_24px_rgba(0,0,0,0.02)] mb-12 flex flex-col md:flex-row justify-between items-center divide-y md:divide-y-0 md:divide-x divide-gray-100"
        data-reveal
      >
        {mapSection.stats.map((stat) => (
          <div class="flex-1 flex flex-col items-center justify-center p-4">
            <span class="font-['Poppins'] font-bold text-[32px] leading-[1] text-[#0A0A0A] mb-2">
              {stat.value}
            </span>
            <span class="font-['Poppins'] font-bold text-[10px] leading-[15px] tracking-[0.08em] text-[#A3A3A3] uppercase">
              {stat.label}
            </span>
          </div>
        ))}
      </div>
    )}

    {groups.map(({ franchise, locations }) => {
      const isComingSoon = franchise.status === "coming_soon";
      return (
        <div class="mb-16 last:mb-0" data-reveal-section>
          {/* Franchise header */}
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-8" data-reveal>
            <div class="text-center md:text-left">
              <div class="flex items-center justify-center md:justify-start gap-3">
                <h3 class="font-['Poppins'] font-bold text-[28px] md:text-[32px] leading-[1.1] text-[#0A0A0A]">
                  {franchise.name}
                </h3>
                {isComingSoon ? (
                  <span class="inline-flex items-center gap-1.5 bg-[#FFF4E5] text-[#B26B00] rounded-full px-3 py-1 font-['Poppins'] font-bold text-[11px] tracking-[0.06em] uppercase">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#F59E0B] animate-pulse" />
                    Coming Soon
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1.5 bg-[#E6F7EE] text-[#067647] rounded-full px-3 py-1 font-['Poppins'] font-bold text-[11px] tracking-[0.06em] uppercase">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#12B76A]" />
                    Live Now
                  </span>
                )}
              </div>
              {franchise.tagline && (
                <p class="font-['Poppins'] text-[15px] text-[#737373] mt-1">
                  {franchise.tagline}
                </p>
              )}
            </div>
            {isComingSoon && (
              <a
                href="/upload"
                class="inline-flex items-center justify-center gap-2 bg-[#3253CC] text-white rounded-full px-6 py-3 font-['Poppins'] font-bold text-[14px] hover:bg-[#2438B5] transition-colors min-h-[44px] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3253CC] focus-visible:ring-offset-2"
              >
                Join the waitlist
              </a>
            )}
          </div>

          {/* Locations grid */}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {locations.map((loc) => {
              const img = resolveImage(loc.image);
              const ph = placeholderFor(loc.venue);
              const Tag = isComingSoon ? "div" : "a";
              return (
                <Tag
                  {...(!isComingSoon ? { href: loc.link, target: "_blank", rel: "noopener noreferrer" } : {})}
                  data-reveal-card
                  class:list={[
                    "group relative block bg-white rounded-[16px] overflow-hidden border border-transparent text-left shadow-[0px_4px_24px_rgba(0,0,0,0.04)] transition-all duration-300",
                    isComingSoon
                      ? "opacity-90"
                      : "hover:shadow-[0px_12px_40px_rgba(50,83,204,0.14)] hover:border-[#E0E7FF] hover:-translate-y-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3253CC] focus-visible:ring-offset-2",
                  ]}
                >
                  {/* Image / placeholder */}
                  <div class="relative aspect-[4/3] overflow-hidden">
                    {img ? (
                      <Image
                        src={img}
                        alt={`${loc.venue}, ${loc.area}`}
                        width={800}
                        height={600}
                        loading="lazy"
                        class:list={[
                          "w-full h-full object-cover transition-transform duration-500",
                          !isComingSoon && "group-hover:scale-105",
                        ]}
                      />
                    ) : (
                      <div
                        class="w-full h-full flex items-center justify-center"
                        style={`background: linear-gradient(135deg, ${ph.from}, ${ph.to});`}
                        role="img"
                        aria-label={`${loc.venue}, ${loc.area}`}
                      >
                        <span class="font-['Outfit'] font-bold text-white/90 text-[40px] tracking-wide drop-shadow-sm">
                          {ph.initials}
                        </span>
                        <svg class="absolute bottom-3 right-3 w-6 h-6 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="2" y="3" width="20" height="14" rx="2" />
                          <path d="M8 21h8M12 17v4" />
                        </svg>
                      </div>
                    )}
                    {isComingSoon && (
                      <div class="absolute inset-0 bg-[#0A1A66]/45 backdrop-blur-[1px] flex items-center justify-center">
                        <span class="font-['Poppins'] font-bold text-white text-[13px] tracking-[0.08em] uppercase bg-black/30 rounded-full px-4 py-1.5">
                          Coming Soon
                        </span>
                      </div>
                    )}
                  </div>

                  {/* Body */}
                  <div class="p-5">
                    <div class="flex items-start gap-3 mb-4">
                      <div class="w-9 h-9 rounded-[10px] bg-[#3253CC] flex items-center justify-center flex-shrink-0 text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4.5 h-4.5">
                          <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                        </svg>
                      </div>
                      <div>
                        <h4 class:list={["font-['Poppins'] font-bold text-[17px] leading-[22px] text-[#0A0A0A] mb-0.5 transition-colors", !isComingSoon && "group-hover:text-[#3253CC]"]}>
                          {loc.area}
                        </h4>
                        <span class="font-['Poppins'] font-bold text-[10px] leading-[15px] tracking-[0.08em] text-[#3253CC] uppercase">
                          {loc.city}
                        </span>
                      </div>
                    </div>
                    <div class="bg-[#F6F7FF] rounded-[8px] p-3 flex justify-between items-center gap-2">
                      <span class="font-['Poppins'] font-medium text-[14px] leading-[20px] text-[#171717] truncate">
                        {loc.venue}
                      </span>
                      <span class="bg-[#E0E7FF] rounded-[6px] px-2.5 py-1 font-['Poppins'] font-bold text-[10px] leading-[15px] text-[#3253CC] whitespace-nowrap flex-shrink-0">
                        {loc.footfall}
                      </span>
                    </div>
                  </div>
                </Tag>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>
</section>
