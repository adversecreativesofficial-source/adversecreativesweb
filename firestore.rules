rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    // Admin records are keyed by the signer's Google email (lowercased).
    function adminEmail() {
      return request.auth.token.email;
    }
    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(adminEmail())).data;
    }
    function isAdmin() {
      return isSignedIn()
        && adminEmail() != null
        && exists(/databases/$(database)/documents/admins/$(adminEmail()))
        && adminDoc().disabled != true;
    }
    function isSuper() {
      return isAdmin() && adminDoc().role == 'super';
    }
    // Super admins see everything; franchise admins are scoped to their franchise.
    function canAccessFranchise(franchise) {
      return isSuper() || (isAdmin() && adminDoc().franchise == franchise);
    }

    // ---- submissions (public "Upload your ad" leads) ----
    match /submissions/{id} {
      // Anyone can submit a lead, but only as a fresh "pending" record.
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.franchise is string
        && request.resource.data.businessName is string
        && request.resource.data.email is string
        && request.resource.data.adUrl is string;
      // Only the owning franchise admin (or super) can read/manage it.
      allow read, update, delete: if canAccessFranchise(resource.data.franchise);
    }

    // ---- screens (shown publicly on the site) ----
    match /screens/{id} {
      allow read: if true;
      allow create: if canAccessFranchise(request.resource.data.franchise);
      allow update, delete: if canAccessFranchise(resource.data.franchise);
    }

    // ---- franchises (optional metadata, shown publicly) ----
    match /franchises/{id} {
      allow read: if true;
      allow write: if isSuper();
    }

    // ---- admins (roles, keyed by lowercased Google email) ----
    match /admins/{email} {
      // An admin can read their own role; super can read all.
      allow read: if isSignedIn() && (adminEmail() == email || isSuper());
      // Only super admins create/modify admin roles.
      allow write: if isSuper();
    }
  }
}
